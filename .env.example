# Copy to .env and fill in. Loaded automatically by meiaribe/settings.py.

# Required: Google Gemini (report generation)
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*
# Signing key for the sign-in JWT
JWT_SECRET_KEY=change-me

# Email for OTPs. Leave EMAIL_HOST_USER empty to print OTP emails to the server console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# AWS S3 for generated reports. Leave AWS_STORAGE_BUCKET_NAME empty to store reports in meiaribe/media/.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=ap-south-1
AWS_STORAGE_BUCKET_NAME=
REPORTS_FOLDER=samplefolder
